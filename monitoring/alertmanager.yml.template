global:
  resolve_timeout: 5m

route:
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: pdftalk_alerts

  routes:
    - match:
        severity: critical
      receiver: pdftalk_alerts
      repeat_interval: 1h

receivers:
  - name: pdftalk_alerts
    webhook_configs:
      - url: http://api:8000/internal/alerts/webhook
        send_resolved: true
        http_config:
          bearer_token: ${ADMIN_TOKEN}
