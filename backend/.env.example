# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pdftalk

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Verification email
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com
LOG_EMAILS_ONLY=False

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxx

# AWS
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=pdftalk-dev

# Grafana
GF_SECURITY_ADMIN_PASSWORD=<openssl rand -base64 24>
GF_SERVER_ROOT_URL=https://pdftalk.com/grafana
GF_SERVER_SERVE_FROM_SUB_PATH=true

# admin access
ADMIN_TOKEN=                   # openssl rand -hex 32
SLACK_WEBHOOK_URL=             # from Slack app settings (optional)
ALERT_EMAIL_TO=you@domain.com
EMAIL_FROM_DOMAIN=pdftalk.com  # used in alerting.py

# Application
APP_URL=http://localhost:3000

MAX_DOCS_PER_USER=20
MAX_DAILY_TOKENS_PER_USER=100000
MAX_DAILY_QUERIES_PER_USER=500
RETRIEVAL_TOP_K=5
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
