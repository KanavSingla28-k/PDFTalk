# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pdftalk

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Verification email
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxx

# AWS
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=pdftalk-dev

# Application
APP_URL=http://localhost:3000

MAX_DOCS_PER_USER=20
MAX_DAILY_TOKENS_PER_USER=100000
MAX_DAILY_QUERIES_PER_USER=500
RETRIEVAL_TOP_K=5
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
