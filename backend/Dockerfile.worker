# =============================================================================
# Stage 1 — builder
# Install dependencies into an isolated venv. Nothing from this stage
# (uv binary, build caches, compile artefacts) leaks into the final image.
# =============================================================================
FROM python:3.12-slim AS builder

# Pin uv version so builds are reproducible.
# Bump this deliberately when you want a newer uv.
COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /usr/local/bin/uv

WORKDIR /app

# System deps needed to *compile* any C-extension wheels (if any).
# libmagic-dev is the header-only dev package; the runtime lib is added
# in the production stage below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy only the dependency manifest first so Docker can cache this layer.
# The venv is rebuilt only when pyproject.toml or uv.lock changes.
COPY pyproject.toml uv.lock ./

# --no-dev       : skip pytest, fakeredis, moto, etc.
# --frozen       : fail if uv.lock is out of sync with pyproject.toml
# --no-cache     : don't write a uv download cache inside the image layer
# UV_PROJECT_ENVIRONMENT: tells uv to install into /app/.venv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
RUN uv sync --frozen --no-dev --no-cache

# =============================================================================
# Stage 2 — production
# Minimal runtime image. Only the venv and application code land here.
# =============================================================================
FROM python:3.12-slim AS production

# ── Runtime system dependencies ──────────────────────────────────────────────
# libmagic1    : required by python-magic (MIME / magic-byte detection)
# tesseract-ocr: required by pytesseract (OCR fallback in extraction service)
# curl         : used by the Docker health check in docker-compose.yml (T-56)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Non-root user ─────────────────────────────────────────────────────────────
# If a remote code execution bug is exploited, the attacker gets a
# low-privilege process instead of root.
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

WORKDIR /app

# Copy the pre-built venv from the builder stage (no uv, no build tools).
COPY --from=builder /app/.venv /app/.venv

# Copy application source.
COPY app/ ./app/

RUN chown -R appuser:appuser /app
USER appuser

# ── PATH: activate the venv without `source activate` ────────────────────────
# Prepending the venv bin dir means `uvicorn`, `alembic`, etc. resolve
# directly without going through `uv run`, so SIGTERM propagates correctly.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD [".venv/bin/rq", "worker", "ingest", "default", "--with-scheduler"]
